<?xml version="1.0"?>
<!--
  시뮬 전체: Gazebo + Nav2 + ArUco 검출 + 도킹 서버 + 도킹 BT + BT 창 + RViz
    ros2 launch vicpinky_docking sim_dock.launch.xml
  로봇은 urdf/vicpinky_sim.urdf.xacro (vic_pinky 로봇 + 카메라 링크) 로 스폰한다.
-->
<launch>
  <arg name="gui" default="true" description="Gazebo GUI"/>
  <!-- gz sim 서버에 더 넘길 옵션 (화면 없는 PC 에서 headless-rendering 등) -->
  <arg name="gz_server_extra" default=""/>
  <arg name="rviz" default="true"/>
  <arg name="bt_viewer" default="true"/>
  <arg name="world" default="$(find-pkg-share vicpinky_docking)/worlds/factory_L1_dock.world"/>
  <arg name="map" default="$(find-pkg-share vicpinky_navigation)/map/factory.yaml"/>
  <arg name="nav2_params" default="$(find-pkg-share vicpinky_navigation)/params/nav2_params.yaml"/>
  <arg name="docking_params" default="$(find-pkg-share vicpinky_docking)/config/docking_sim.yaml"/>
  <arg name="marker_params" default="$(find-pkg-share vicpinky_docking)/config/track_marker_sim.yaml"/>
  <arg name="marker_id" default="0"/>
  <arg name="marker_size" default="0.08"/>
  <arg name="x" default="14.0"/>
  <arg name="y" default="-16.0"/>
  <arg name="yaw" default="0.0"/>

  <set_env name="GZ_SIM_RESOURCE_PATH"
           value="$(find-pkg-share vicpinky_description)/../:$(find-pkg-share vicpinky_gazebo)/models:$(find-pkg-share vicpinky_docking)/models:$(env HOME)/.gazebo/models"/>

  <!-- Gazebo -->
  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    <arg name="gz_args" value="-r -s -v2 $(var gz_server_extra) $(var world)"/>
    <arg name="on_exit_shutdown" value="true"/>
  </include>
  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py" if="$(var gui)">
    <arg name="gz_args" value="-g -v2"/>
  </include>

  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher" output="screen">
    <param name="robot_description" type="str"
           value="$(command 'xacro $(find-pkg-share vicpinky_docking)/urdf/vicpinky_sim.urdf.xacro')"/>
    <param name="use_sim_time" value="true"/>
  </node>

  <node pkg="ros_gz_sim" exec="create" name="create" output="screen"
        args="-name vicpinky -topic robot_description -x $(var x) -y $(var y) -z 0.3 -Y $(var yaw)">
    <param name="use_sim_time" value="true"/>
  </node>

  <node pkg="ros_gz_bridge" exec="parameter_bridge" name="parameter_bridge" output="screen"
        args="--ros-args -p config_file:=$(find-pkg-share vicpinky_gazebo)/params/pinky_bridge.yaml"/>
  <node pkg="ros_gz_image" exec="image_bridge" name="image_bridge" output="screen" args="/camera/image_raw">
    <param name="use_sim_time" value="true"/>
  </node>

  <!-- AMCL 이 쓰는 scan_filtered -->
  <node pkg="laser_filters" exec="scan_to_scan_filter_chain">
    <param from="$(find-pkg-share vicpinky_bringup)/config/laser_filter.yaml"/>
    <param name="use_sim_time" value="true"/>
  </node>

  <include file="$(find-pkg-share vicpinky_navigation)/launch/bringup_launch.xml">
    <arg name="map" value="$(var map)"/>
    <arg name="params_file" value="$(var nav2_params)"/>
    <arg name="use_sim_time" value="True"/>
  </include>

  <include file="$(find-pkg-share vicpinky_docking)/launch/detector.launch.xml">
    <arg name="params_file" value="$(var marker_params)"/>
    <arg name="image_topic" value="/camera/image_raw"/>
    <arg name="camera_info_topic" value="/camera/camera_info"/>
    <arg name="marker_id" value="$(var marker_id)"/>
    <arg name="marker_size" value="$(var marker_size)"/>
    <arg name="use_sim_time" value="true"/>
  </include>

  <include file="$(find-pkg-share vicpinky_docking)/launch/docking.launch.xml">
    <arg name="params_file" value="$(var docking_params)"/>
    <arg name="use_sim_time" value="true"/>
  </include>

  <node pkg="vicpinky_docking" exec="bt_viewer.py" name="bt_viewer" output="screen" if="$(var bt_viewer)">
    <param name="use_sim_time" value="true"/>
  </node>

  <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen" if="$(var rviz)"
        args="-d $(find-pkg-share vicpinky_docking)/rviz/docking.rviz">
    <param name="use_sim_time" value="true"/>
  </node>
</launch>

<?xml version="1.0"?>
<!--
  도킹 서버 + 도킹 BT 실행기 (sim_dock / real_dock 이 include 한다)
  액션: /dock_robot, /undock_robot (도킹 서버), /docking/navigate_to_pose (도킹 BT)
-->
<launch>
  <arg name="params_file" default="$(find-pkg-share vicpinky_docking)/config/docking_sim.yaml"/>
  <arg name="bt_params_file" default="$(find-pkg-share vicpinky_docking)/config/docking_bt.yaml"/>
  <arg name="bt_xml" default="$(find-pkg-share vicpinky_docking)/behavior_trees/dock_to_station.xml"/>
  <arg name="use_sim_time" default="true"/>

  <node pkg="opennav_docking" exec="opennav_docking" name="docking_server" output="screen">
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="lifecycle_manager_docking" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="autostart" value="true"/>
    <param name="bond_timeout" value="0.0"/>
    <param name="node_names" value="['docking_server']"/>
  </node>

  <!-- 도킹 BT 실행기: bt_navigator 를 네임스페이스 docking 에 하나 더 -->
  <group>
    <push-ros-namespace namespace="docking"/>
    <node pkg="nav2_bt_navigator" exec="bt_navigator" name="bt_navigator" output="screen">
      <param from="$(var bt_params_file)"/>
      <param name="use_sim_time" value="$(var use_sim_time)"/>
      <param name="default_nav_to_pose_bt_xml" value="$(var bt_xml)"/>
    </node>
    <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="lifecycle_manager_docking_bt" output="screen">
      <param name="use_sim_time" value="$(var use_sim_time)"/>
      <param name="autostart" value="true"/>
      <param name="bond_timeout" value="0.0"/>
      <param name="node_names" value="['bt_navigator']"/>
    </node>
  </group>
</launch>
